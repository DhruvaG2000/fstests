# Common helpers for Btrfs DEFRAG_RANGE_NOCOMPRESS tests.

_nc_require()
{
	_require_scratch
	_require_test_program btrfs_defrag_range
	_require_xfs_io_command fiemap ranged
	_require_btrfs_command filesystem defragment --nocomp
}

# Call after mounting the scratch filesystem.  Unknown flags are a skip only
# for this explicit feature probe; every later unexpected failure is fatal.
_nc_probe()
{
	local result
	$XFS_IO_PROG -f -c 'pwrite 0 128K' -c fsync \
		"$SCRATCH_MNT/nocomp-probe" >> "$seqres.full" 2>&1 ||
		_fail "cannot create nonempty NOCOMPRESS probe"
	result=$($here/src/btrfs_defrag_range "$SCRATCH_MNT/nocomp-probe" \
		8 0 131072 0 0) || _fail "NOCOMPRESS probe failed unexpectedly"
	echo "probe: $result" >> "$seqres.full"
	case "$result" in
	OK) ;;
	EOPNOTSUPP|ENOTTY) _notrun "DEFRAG_RANGE_NOCOMPRESS unsupported" ;;
	*) _fail "NOCOMPRESS probe returned $result" ;;
	esac
	rm -f "$SCRATCH_MNT/nocomp-probe"
}

_nc_probe_algorithm()
{
	local algorithm=$1 file="$SCRATCH_MNT/nocomp-$1-probe" output
	_nc_write "$file" 0 128K 0x55
	if ! $BTRFS_UTIL_PROG filesystem defragment "-c$algorithm" "$file" \
		> "$tmp.algorithm" 2>&1; then
		cat "$tmp.algorithm" >> "$seqres.full"
		grep -qi 'not supported\|unsupported' "$tmp.algorithm" &&
			_notrun "$algorithm compression unsupported"
		_fail "$algorithm compression probe failed"
	fi
	sync
	_nc_encoded "$file" 0 128K
	rm -f "$file"
}

_nc_write()
{
	local file=$1 offset=$2 length=$3 byte=$4
	$XFS_IO_PROG -f -c "pwrite -S $byte -b 128K $offset $length" \
		-c fsync "$file" >> "$seqres.full" 2>&1 ||
		_fail "write failed: $file at $offset"
}

_nc_defrag()
{
	$BTRFS_UTIL_PROG filesystem defragment --nocomp "$@" \
		>> "$seqres.full" 2>&1 || _fail "NOCOMPRESS defrag failed: $*"
	sync
}

_nc_map()
{
	local file=$1 offset=$2 length=$3
	$XFS_IO_PROG -c "fiemap -v $offset $length" "$file" \
		> "$tmp.nc-map" 2>> "$seqres.full" || _fail "fiemap failed: $file"
	cat "$tmp.nc-map" >> "$seqres.full"
}

_nc_encoded()
{
	_nc_map "$1" "$2" "$3"
	grep -Eq '^[[:space:]]*[0-9]+:' "$tmp.nc-map" || _fail "no mapping: $1 $2"
	_filter_fiemap_flags 1 < "$tmp.nc-map" > "$tmp.nc-flags" || _fail "fiemap flags failed"
	grep -q unwritten "$tmp.nc-flags" && _fail "unwritten mapping: $1 $2"
	grep -q encoded "$tmp.nc-flags" || _fail "not compressed: $1 $2"
	return 0
}

_nc_unencoded()
{
	_nc_map "$1" "$2" "$3"
	grep -Eq '^[[:space:]]*[0-9]+:' "$tmp.nc-map" || _fail "no mapping: $1 $2"
	_filter_fiemap_flags 1 < "$tmp.nc-map" > "$tmp.nc-flags" || _fail "fiemap flags failed"
	grep -q unwritten "$tmp.nc-flags" && _fail "unwritten mapping: $1 $2"
	grep -q encoded "$tmp.nc-flags" && _fail "still compressed: $1 $2"
	return 0
}

_nc_same()
{
	[ "$1" = "$2" ] || _fail "content digest changed"
}

_nc_raw_expect()
{
	local expected=$1 actual
	shift
	actual=$($here/src/btrfs_defrag_range "$@") || _fail "raw ioctl execution failed"
	echo "raw: $* -> $actual" >> "$seqres.full"
	[ "$actual" = "$expected" ] || _fail "raw ioctl: expected $expected, got $actual"
}
